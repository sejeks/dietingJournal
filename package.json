{
  "name": "dieting-app",
  "version": "1.0.0",
  "description": "A desktop application to track daily food intake and nutrition goals",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/migrate-data.js",
    "build": "electron-builder",
    "postbuild": "node scripts/install-app.js",
    "build:dmg": "electron-builder --mac dmg",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sejeks/dietingJournal.git"
  },
  "keywords": [
    "electron",
    "diet",
    "nutrition",
    "tracking"
  ],
  "author": "sejeks",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sejeks/dietingJournal/issues"
  },
  "homepage": "https://github.com/sejeks/dietingJournal#readme",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dieting.journal",
    "productName": "Dieting App",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "vendor/**",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  }
}
